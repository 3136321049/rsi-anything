{
  "origin": "项目作者原创固定练习；无真实学生数据。",
  "exercises": [
    {
      "id": "P1",
      "topic": "基本求部分",
      "question": "一批练习本共240本，其中35%是方格本。方格本有多少本？",
      "expected": 84,
      "unit": "本",
      "tolerance": 0.0001,
      "solution": "240×0.35=84。"
    },
    {
      "id": "P2",
      "topic": "还原原量",
      "question": "书店打八折后一本书售价72元。原价是多少元？",
      "expected": 90,
      "unit": "元",
      "tolerance": 0.0001,
      "solution": "打八折保留原价的0.8，72÷0.8=90。"
    },
    {
      "id": "P3",
      "topic": "增长率",
      "question": "某社团人数从40人增加到50人。增长率是多少百分比？答案填百分数前的数值。",
      "expected": 25,
      "unit": "%",
      "tolerance": 0.0001,
      "solution": "增加10人，以原来的40人为基数，10÷40×100=25。"
    },
    {
      "id": "P4",
      "topic": "减少率",
      "question": "一项活动的报名人数由125人减少到100人。减少率是多少百分比？答案填百分数前的数值。",
      "expected": 20,
      "unit": "%",
      "tolerance": 0.0001,
      "solution": "减少25人，以原来的125人为基数，25÷125×100=20。"
    },
    {
      "id": "P5",
      "topic": "连续变化",
      "question": "一件商品原价200元，先涨价10%，再降价10%。最后价格是多少元？",
      "expected": 198,
      "unit": "元",
      "tolerance": 0.0001,
      "solution": "200×1.1×0.9=198，两个百分比的基数不同。"
    },
    {
      "id": "P6",
      "topic": "百分点",
      "question": "某问卷中支持比例由30%升到42%。上升了多少个百分点？",
      "expected": 12,
      "unit": "个百分点",
      "tolerance": 0.0001,
      "solution": "42%-30%=12个百分点。"
    },
    {
      "id": "P7",
      "topic": "变化后还原",
      "question": "一袋米取出原有重量的25%后，剩下18千克。原有多少千克？",
      "expected": 24,
      "unit": "千克",
      "tolerance": 0.0001,
      "solution": "剩下75%，18÷0.75=24。"
    },
    {
      "id": "P8",
      "topic": "整体变化",
      "question": "甲班有30人，其中40%参加合唱；乙班有20人，其中25%参加合唱。两班合计有多少百分比参加合唱？答案填百分数前的数值。",
      "expected": 34,
      "unit": "%",
      "tolerance": 0.0001,
      "solution": "人数为12+5=17，整体为50，17÷50×100=34。"
    },
    {
      "id": "P9",
      "topic": "反向变化率",
      "question": "一个数先减少20%后，要回到原来的数，需要在减少后的基础上增加多少百分比？答案填百分数前的数值。",
      "expected": 25,
      "unit": "%",
      "tolerance": 0.0001,
      "solution": "减少后是原量0.8，需增加0.2÷0.8=25%。"
    },
    {
      "id": "P10",
      "topic": "比例与部分",
      "question": "一杯糖水总重150克，其中糖占12%。加入50克水后，糖占总重多少百分比？答案填百分数前的数值。",
      "expected": 9,
      "unit": "%",
      "tolerance": 0.0001,
      "solution": "糖18克不变，总重200克，18÷200×100=9。"
    }
  ]
}
